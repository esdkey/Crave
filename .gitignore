# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# prisma local sqlite
dev.db*
*.db-journal

# local logs
*.log

# user-uploaded content (product images / payment screenshots)
# Ignore uploads except product images, which are shipped with the repo so
# they render on Railway's ephemeral filesystem.
/public/uploads/*
!/public/uploads/products/
!/public/uploads/products/*

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
.neon
