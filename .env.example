# ── Crave — environment variables ──
# Copy to `.env` and fill in your values. Never commit `.env`.

# Local SQLite DB (file path). For production Postgres, swap this URL
# and the Prisma driver adapter in src/lib/prisma.ts.
DATABASE_URL="file:./dev.db"

# Session signing secret (random string, must be secret).
SESSION_SECRET="generate-a-long-random-string"

# Telegram bot for new-order notifications.
# Leave empty to disable notifications (site still works).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# E-wallet/InstaPay numbers shown to customers when they pick that payment
# method at checkout. Leave empty to hide the transfer-number box.
PAYMENT_VODAFONE_NUMBER=""
PAYMENT_INSTAPAY_NUMBER=""

# Seed admin account (used by `npx prisma db seed`).
ADMIN_EMAIL="ismail@crave.com"
ADMIN_PASSWORD="crave-admin-123"
ADMIN_NAME="Crave Admin"
